ANTHROPIC_API_KEY=
# Valgfritt: bytt modell for romassistenten
# STUDIO_MODEL=claude-opus-5

# Pinterest-app fra https://developers.pinterest.com/apps/
# Registrer redirect-URI-en nøyaktig som under i appens innstillinger.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback

# sandbox (standard) eller production. Trial-apper KAN ikke opprette pins mot
# produksjons-API-et (403 code 29) — de må bruke sandbox, som har eget token og
# egne tavler (lista starter tom). Sett production først når appen er godkjent
# for Standard access.
PINTEREST_ENV=sandbox

# ---------------------------------------------------------------------------
# Kontoer og betaling for Romassistenten (/studio)
# ---------------------------------------------------------------------------
# Clerk-app fra https://dashboard.clerk.com — uten disse to er /studio som før:
# kun tilgjengelig i npm run dev, og innlogging vises ikke i headeren.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/logg-inn
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registrer
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/studio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/studio

# E-poster (komma-separert) som får full studiotilgang uten abonnement,
# inkludert Pinterest-publisering og lagring til repoet.
STUDIO_OWNER_EMAILS=

# Antall analyser per bruker per måned. Standard 30.
STUDIO_MONTHLY_QUOTA=30

# Stripe fra https://dashboard.stripe.com. STRIPE_PRICE_ID er price_... for
# abonnementsproduktet. Webhook-secret kommer fra `stripe listen` lokalt og fra
# webhook-endepunktet (/api/stripe/webhook) i produksjon.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Sett til 1 først når Stripe Tax er skrudd på i dashboardet.
STRIPE_AUTOMATIC_TAX=
NEXT_PUBLIC_STUDIO_PRICE_LABEL=kr 149 / month
NEXT_PUBLIC_SITE_URL=http://localhost:3000
